{
  "name": "countdown-todo",
  "version": "1.0.0",
  "description": "Todo application with countdown timers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:port": "node -e \"process.env.PORT='3000';require('./server.js')\"",
    "start:lan": "node -e \"process.env.HOST='0.0.0.0';require('./server.js')\"",
    "up": "node scripts/launcher.js start --open",
    "up:lan": "node scripts/launcher.js start --open --lan",
    "down": "node scripts/launcher.js stop",
    "restart": "node scripts/launcher.js restart",
    "status": "node scripts/launcher.js status",
    "logs": "node scripts/launcher.js logs",
    "test": "jest"
  },
  "keywords": [
    "todo",
    "countdown",
    "timer"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=12.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  }
}
